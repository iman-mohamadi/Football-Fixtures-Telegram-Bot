# --- Telegram ---------------------------------------------------------------
# Token from @BotFather. Never commit the real value.
TELEGRAM_BOT_TOKEN=
# polling (development) | webhook (production)
BOT_MODE=polling
# webhook mode only: public HTTPS base URL (the bot registers <WEBHOOK_URL>/telegram) and a random secret
WEBHOOK_URL=
WEBHOOK_SECRET=
PORT=3000

# --- Database ---------------------------------------------------------------
# Leave empty for in-memory storage (development only: data is lost on restart).
DATABASE_URL=

# --- Football data ----------------------------------------------------------
# Free token from https://www.football-data.org/client/register (international competitions)
FOOTBALL_DATA_TOKEN=
# Keyless German fallback/extra competitions (BL1 fallback, BL2, DFB-Pokal)
ENABLE_OPENLIGADB=true
# Paid Iranian provider (https://www.victoryapi.ir). Leave empty to hide Iranian competitions.
VICTORYAPI_KEY=

# Optional free key from https://www.api-football.com (100 requests/day). Adds Europa/Conference League and
# anything on your plan that is verified at startup (check the log line 'apisports competitions verified').
API_FOOTBALL_KEY=
# JSON file used to persist API responses when DATABASE_URL is empty (restarts then do not re-spend quota)
CACHE_FILE=.cache/football-cache.json

# --- Defaults ---------------------------------------------------------------
# Only used as fallback; the first-run language choice sets the initial timezone (fa -> Asia/Tehran, en -> UTC)
DEFAULT_TIMEZONE=Asia/Tehran
DEFAULT_LANG=fa
LOG_LEVEL=info
